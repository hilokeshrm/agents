# SQLite by default -- no Postgres server required. Point at a real
# postgresql+psycopg:// URL once Postgres is provisioned (pip install ".[postgres]" first).
DATABASE_URL=sqlite:///./opptrack.db

ANTHROPIC_API_KEY=
JUDGMENT_MODE=mock
AUTH_ISSUER=
AUTH_AUDIENCE=

# /dev/* (app/api/v1/dev.py): unauthenticated DB table browser and log tail.
# Fine to leave on for local work; a public deployment MUST set this to
# false -- see deliverables/deploy/README.md.
DEV_TOOLS_ENABLED=true

# "fake" runs an in-process Redis stand-in (fakeredis) -- no server needed.
# Set to "real" once an actual Redis instance exists.
REDIS_BACKEND=fake
REDIS_URL=redis://localhost:6379/0

# "local" writes objects to ./data/objects on disk -- no S3/MinIO needed.
# Set to "s3" once a real S3-compatible endpoint exists.
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=opptrack
