# Production env for the public-IP deployment. Copy this to
# deploy/.env.production and fill it in -- that file is gitignored (see
# ../.gitignore) and must never be committed.
#
#   cp deploy/.env.production.example deploy/.env.production

# --- Reachability -------------------------------------------------------- #

# The host Caddy requests a certificate for and the SPA is served from.
# No domain yet? Use a nip.io hostname built from your public IP -- replace
# the dots with dashes and append .nip.io. IP 203.0.113.45 becomes:
OPPTRACK_DOMAIN=203-0-113-45.nip.io
# Once you own a real domain, point its A record at the public IP and put
# it here instead -- Caddy picks up the change on restart, nothing else to do.

# Who is allowed to call the API cross-origin. Always include OPPTRACK_DOMAIN
# itself (harmless -- same-origin calls don't need CORS but listing it here
# doesn't hurt); add your GitHub Pages origin if you're using deploy-pages.yml.
# Comma-separated, no spaces, no trailing slash.
CORS_ORIGINS=https://203-0-113-45.nip.io,https://YOUR-GITHUB-USERNAME.github.io

# --- Auth (AUTH_MODE=local is hardcoded in docker-compose.prod.yml) ------ #

# How the one-time sign-in code reaches a user. "console" just puts it in
# the backend container log (docker compose logs backend) -- fine only for
# you, as the one admin account, until SMTP is configured. Every other
# person who needs to sign in needs OTP_DELIVERY=smtp below.
OTP_DELIVERY=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=opptrack@yourdomain.example

# --- Database / object storage (Postgres + MinIO, per the full-stack profile) #
POSTGRES_PASSWORD=change-me

MINIO_ROOT_USER=opptrack
MINIO_ROOT_PASSWORD=change-me-too

# --- Judgment model: local vLLM on this machine's GPU --------------------- #
# Leave JUDGMENT_MODE=mock while you're still smoke-testing the deployment
# itself -- it costs nothing and calls no model. Switch to "live" once the
# vllm container is confirmed up (docker compose logs vllm) and you're ready
# for real judgment calls.
JUDGMENT_MODE=mock
JUDGMENT_BACKEND=vllm
VLLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
# Required for gated models on Hugging Face (Llama included). Get one at
# https://huggingface.co/settings/tokens and accept the model's license
# first, or the vllm container will fail to download weights.
HUGGING_FACE_HUB_TOKEN=

# Only relevant if you skip --profile local-model and use the Anthropic API
# instead (set JUDGMENT_BACKEND=anthropic above too):
ANTHROPIC_API_KEY=
